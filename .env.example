# Copy to .env.local and fill in for a real deployment.
# Both values are published in the rendered page; they are settings, not secrets.

# Formspree form endpoint, e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Google Tag Manager container, e.g. GTM-XXXXXXX. When unset, no Tag Manager
# script is rendered.
NEXT_PUBLIC_GTM_ID=
